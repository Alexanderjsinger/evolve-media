---
import "@fontsource/schibsted-grotesk/latin-400.css";
import "@fontsource/schibsted-grotesk/latin-500.css";
import "@fontsource/schibsted-grotesk/latin-700.css";
import "@fontsource/schibsted-grotesk/latin-800.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { analyticsId, analyticsIsLive, fullName, name, siteUrl } from "../data/site";

interface Props {
  title: string;
  description: string;
  robots?: string;
  jsonLd?: Record<string, unknown>;
  ink?: boolean;
}

const { title, description, robots, jsonLd, ink = false } = Astro.props;
const canonical = siteUrl
  ? new URL(Astro.url.pathname, siteUrl.endsWith("/") ? siteUrl : `${siteUrl}/`).href
  : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={fullName} />
    <meta name="theme-color" content="#10110f" />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {
      analyticsIsLive && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`} />
          <script define:vars={{ analyticsId }} is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", analyticsId);
          </script>
        </>
      )
    }
  </head>
  <body class:list={[ink && "page-ink"]}>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
