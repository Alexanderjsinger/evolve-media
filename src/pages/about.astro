---
import Base from "../layouts/Base.astro";
import InquiryForm from "../components/InquiryForm.astro";
import {
  aboutBelief,
  aboutTestimonials,
  credentials,
  fullName,
  headshot,
  howHeWorks,
  linkedInIsLive,
  linkedInUrl,
  pageMeta,
  pending,
  price,
} from "../data/site";
---

<Base title={pageMeta.about.title} description={pageMeta.about.description}>
  <header class="page-intro wrap">
    <h1 class="display about-display">About</h1>
    <p class="about-belief">{aboutBelief}</p>
    <h2 class="about-name">{fullName}</h2>
    <p class:list={["photo-slot", pending(headshot) && "awaiting"]}>{headshot}</p>
    <p>I’m Alexander. I run Kindling Works.</p>
    <p class:list={[pending(howHeWorks) && "awaiting"]}>{howHeWorks}</p>
    <ul class="plain-list">
      {
        credentials.map((line) => (
          <li class:list={[pending(line) && "awaiting"]}>{line}</li>
        ))
      }
    </ul>
    <p>
      {
        linkedInIsLive ? (
          <a href={linkedInUrl} target="_blank" rel="noopener noreferrer">
            LinkedIn
          </a>
        ) : (
          <span class="awaiting">{linkedInUrl}</span>
        )
      }
    </p>
    <p>
      Two businesses are on the <a href="/work">work page</a>: Xtreme Mats and Caruso
      Caruso.
    </p>
    <h2>What clients say</h2>
    <p class="awaiting">{aboutTestimonials}</p>
    <p class="price">{price}</p>
  </header>

  <InquiryForm heading="Tell me about the business" intro="I read every note." />
</Base>
