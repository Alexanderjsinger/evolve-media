---
import Base from "../layouts/Base.astro";
import { price, stories } from "../data/site";

const description =
  "Xtreme Mats, one brand with two audiences. Caruso Caruso, advertising and social, with one campaign at 5x ROAS.";
---

<Base title="Selected work | Evolve Media" description={description}>
  <header class="page-hero">
    <div class="wrap">
      <p class="mono">Work</p>
      <h1>Selected work</h1>
      <p>Two businesses. The live sites are the proof.</p>
    </div>
  </header>

  {
    stories.map((story) => (
      <article class="story wrap" id={story.id}>
        <p class="mono">
          {story.eyebrow} · {story.client}
        </p>
        <h2 class="display">{story.line}</h2>
        {story.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <p class="links">
          {story.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          ))}
        </p>
      </article>
    ))
  }

  <section class="band">
    <div class="wrap band-inner">
      <p class="price">{price}</p>
      <a class="button" href="/start">Tell me about the business</a>
    </div>
  </section>
</Base>
