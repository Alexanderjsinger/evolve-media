---
import Base from "../layouts/Base.astro";
import WorkCrop from "../components/WorkCrop.astro";
import { pageMeta, pending, price, stories, workIntro } from "../data/site";
---

<Base title={pageMeta.work.title} description={pageMeta.work.description}>
  <header class="page-hero">
    <div class="wrap">
      <p class="mono">Work</p>
      <h1>Selected work</h1>
      <p>{workIntro}</p>
    </div>
  </header>

  {
    stories.map((story) => (
      <article class="story wrap" id={story.id}>
        <p class="mono">
          {story.years
            ? `${story.client} · ${story.industry} · ${story.years}`
            : `${story.client} · ${story.industry}`}
        </p>
        <h2 class="display">{story.title}</h2>
        <WorkCrop
          id={story.id}
          src={story.crop.src}
          alt={story.crop.alt}
          framed
        />
        <div class="case-meta">
          <div>
            <h3>My role</h3>
            <p>{story.role}</p>
          </div>
          <div>
            <h3>{story.situationLabel}</h3>
            <p>{story.situation}</p>
          </div>
          <div>
            <h3>What I did</h3>
            <ul>
              {story.actions.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div>
            <h3>Result</h3>
            <p class:list={[pending(story.result) && "awaiting"]}>{story.result}</p>
          </div>
          <div>
            <h3>Quote</h3>
            <p class:list={[pending(story.quote) && "awaiting"]}>{story.quote}</p>
          </div>
        </div>
        <p class="links">
          {story.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          ))}
        </p>
      </article>
    ))
  }

  <section class="band">
    <div class="wrap band-inner">
      <p class="price">{price}</p>
      <a class="button" href="/start">Tell me about the business</a>
    </div>
  </section>
</Base>
