---
import Base from "../layouts/Base.astro";
import InquiryForm from "../components/InquiryForm.astro";
import {
  bestFit,
  email,
  firstProof,
  fullName,
  headline,
  lede,
  locationLine,
  name,
  offers,
  pageMeta,
  positioning,
  price,
  siteUrl,
  stages,
  steps,
  stories,
} from "../data/site";

const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name,
  url: siteUrl,
  email,
  founder: {
    "@type": "Person",
    name: fullName,
    email,
  },
  areaServed: "United States",
  knowsAbout: ["Digital marketing", "Websites", "Technical setup"],
};
---

<Base title={pageMeta.home.title} description={pageMeta.home.description} jsonLd={jsonLd}>
  <section class="opening">
    <div class="wrap hero-grid">
      <div>
        <p class="positioning">{positioning}</p>
        <h1>{headline}</h1>
      </div>
      <div>
        <p class="lede">{lede}</p>
        <p class="lede">{locationLine}</p>
        <p class="price">{price}</p>
        <div class="hero-actions">
          <a class="button" href="#inquiry">Tell me about the business</a>
          <a class="text-link" href="/work">See the work</a>
        </div>
      </div>
    </div>
    <div class="wrap">
      <div class="signal" aria-hidden="true">
        <span class="signal-seg"><span class="signal-fill signal-fill-plan"></span></span>
        <span class="signal-seg"><span class="signal-fill signal-fill-create"></span></span>
        <span class="signal-seg"><span class="signal-fill signal-fill-publish"></span></span>
        <span class="signal-seg"><span class="signal-fill signal-fill-evolve"></span></span>
      </div>
      <ol class="cycle">
        {
          stages.map((stage) => (
            <li class={`cycle-${stage.id}`}>
              <span class="mark" aria-hidden="true">
                <span></span>
              </span>
              <p class="mono">{stage.label}</p>
              <p>{stage.body}</p>
            </li>
          ))
        }
      </ol>
      <aside class="proof-strip">
        <p class="mono">Proof</p>
        <p class="awaiting awaiting-dark">{firstProof}</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="mono section-label">Selected work</h2>
      <div class="proof">
        {
          stories.map((story) => (
            <a class="proof-panel" href={`/work#${story.id}`}>
              <p class="mono">{story.industry}</p>
              <p class="figure figure-line">{story.title}</p>
              <h3>{story.client}</h3>
              <p>{story.summary}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>What a hire includes</h2>
      <div class="hire">
        {
          offers.map((offer) => (
            <article class="hire-row">
              <p class="mono">{offer.stage}</p>
              <h3>{offer.title}</h3>
              <p>{offer.short}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>How it starts</h2>
      <ol class="steps">
        {
          steps.map((step) => (
            <li>
              <span class="num">{step.num}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="wrap band-inner">
      <h2>Best fit</h2>
      <p>{bestFit}</p>
      <p class="price">{price}</p>
    </div>
  </section>

  <InquiryForm heading="Tell me about the business" intro="I read every note." />
</Base>
