---
import Base from "../layouts/Base.astro";
import InquiryForm from "../components/InquiryForm.astro";
import {
  bestFit,
  email,
  headline,
  lede,
  name,
  offers,
  person,
  price,
  stages,
  steps,
  stories,
} from "../data/site";

const description =
  "Alexander runs digital marketing for small and mid-size businesses. Plan, create, publish, then evolve the work. Monthly marketing starts at $1,500.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name,
  description,
  email,
  founder: {
    "@type": "Person",
    name: person,
    email,
  },
  areaServed: "Worldwide",
  knowsAbout: [
    "Digital marketing",
    "Websites",
    "Technical setup",
    "Answer engine optimization",
  ],
};

const proof = [...stories].sort(
  (a, b) => Number(Boolean(b.figure)) - Number(Boolean(a.figure)),
);
---

<Base
  title="Evolve Media | Digital marketing for small businesses"
  description={description}
  jsonLd={jsonLd}
>
  <section class="opening">
    <div class="wrap hero-grid">
      <h1>{headline}</h1>
      <div>
        <p class="lede">{lede}</p>
        <p class="price">{price}</p>
        <a class="button" href="#inquiry">Tell me about the business</a>
      </div>
    </div>
    <div class="wrap">
      <div class="signal" aria-hidden="true">
        <span class="signal-seg"><span class="signal-fill signal-fill-plan"></span></span>
        <span class="signal-seg"><span class="signal-fill signal-fill-create"></span></span>
        <span class="signal-seg"><span class="signal-fill signal-fill-publish"></span></span>
        <span class="signal-seg"><span class="signal-fill signal-fill-evolve"></span></span>
      </div>
      <ol class="cycle">
        {
          stages.map((stage) => (
            <li class={`cycle-${stage.id}`}>
              <span class="mark" aria-hidden="true">
                <span></span>
              </span>
              <p class="mono">{stage.label}</p>
              <p>{stage.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="mono section-label">Selected work</h2>
      <div class="proof">
        {
          proof.map((story) => (
            <a class="proof-panel" href={`/work#${story.id}`}>
              <p class="mono">{story.eyebrow}</p>
              <p class={story.figure ? "figure" : "figure figure-line"}>
                {story.figure || story.line}
              </p>
              <h3>{story.client}</h3>
              <p>{story.figure ? story.line : story.summary}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>What a hire includes</h2>
      <div class="hire">
        {
          offers.map((offer) => (
            <article class="hire-row">
              <p class="mono">{offer.stage}</p>
              <h3>{offer.title}</h3>
              <p>{offer.short}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>How it starts</h2>
      <ol class="steps">
        {
          steps.map((step) => (
            <li>
              <span class="num">{step.num}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="wrap band-inner">
      <h2>Best fit</h2>
      <p>{bestFit}</p>
      <p class="price">{price}</p>
    </div>
  </section>

  <InquiryForm heading="Tell me about the business" intro="I read every note." />
</Base>
