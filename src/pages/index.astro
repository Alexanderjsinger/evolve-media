---
import Base from "../layouts/Base.astro";
import InquiryForm from "../components/InquiryForm.astro";
import {
  bestFit,
  email,
  headline,
  lede,
  name,
  offers,
  person,
  price,
  steps,
  stories,
} from "../data/site";

const description =
  "Alexander runs digital marketing for small and mid-size businesses. Monthly marketing starts at $1,500.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name,
  description,
  email,
  founder: {
    "@type": "Person",
    name: person,
    email,
  },
  areaServed: "Worldwide",
  knowsAbout: [
    "Digital marketing",
    "Websites",
    "Technical setup",
    "Answer engine optimization",
  ],
};
---

<Base
  title="Evolve Media | Digital marketing for small businesses"
  description={description}
  jsonLd={jsonLd}
>
  <section class="hero wrap">
    <h1>{headline}</h1>
    <div>
      <p class="lede">{lede}</p>
      <p class="price">{price}</p>
      <a class="button" href="#inquiry">Tell me about the business</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="eyebrow">Selected work</h2>
      <div class="work-list">
        {
          stories.map((story) => (
            <a class="work-row" href={`/work#${story.id}`}>
              <div>
                <p class="kicker">{story.eyebrow}</p>
                <h3>{story.client}</h3>
              </div>
              <p>{story.summary}</p>
              <span class="go" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="eyebrow">What I do</h2>
      <article class="job-lead">
        <span class="num">{offers[0].num}</span>
        <div>
          <h3>{offers[0].title}</h3>
          <p>{offers[0].short}</p>
        </div>
      </article>
      <div class="job-rest">
        {
          offers.slice(1).map((offer) => (
            <article>
              <span class="num">{offer.num}</span>
              <h3>{offer.title}</h3>
              <p>{offer.short}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="eyebrow">How it starts</h2>
      <ol class="steps">
        {
          steps.map((step) => (
            <li>
              <span class="num">{step.num}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="wrap band-inner">
      <h2>Best fit</h2>
      <p>{bestFit}</p>
      <p class="price">{price}</p>
    </div>
  </section>

  <InquiryForm
    heading="Tell me about the business"
    intro="I read every note."
  />
</Base>
