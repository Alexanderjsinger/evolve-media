---
import Base from "../layouts/Base.astro";
import InquiryForm from "../components/InquiryForm.astro";
import WorkCrop from "../components/WorkCrop.astro";
import {
  bestFit,
  email,
  firstProof,
  fullName,
  headlineAccent,
  headlineLead,
  lede,
  locationLine,
  name,
  offers,
  pageMeta,
  pending,
  price,
  siteUrl,
  stages,
  steps,
  stories,
} from "../data/site";

const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name,
  url: siteUrl,
  email,
  founder: {
    "@type": "Person",
    name: fullName,
    email,
  },
  areaServed: "United States",
  knowsAbout: ["Digital marketing", "Websites", "Technical setup"],
};
---

<Base title={pageMeta.home.title} description={pageMeta.home.description} jsonLd={jsonLd}>
  <section class="opening">
    <div class="wrap hero-grid hero-fade">
      <div>
        <h1>
          {headlineLead} <span class="headline-accent">{headlineAccent}</span>
        </h1>
      </div>
      <div>
        <p class="lede">{lede}</p>
        <p class="lede">{locationLine}</p>
        <p class="price">{price}</p>
        <div class="hero-actions">
          <a class="button" href="#inquiry">Tell me about the business</a>
          <a class="text-link" href="/work">See the work</a>
        </div>
      </div>
    </div>
    <div class="wrap">
      <div class="signal" aria-hidden="true">
        <span class="signal-seg"><span class="signal-fill signal-fill-plan"></span></span>
        <span class="signal-seg"><span class="signal-fill signal-fill-create"></span></span>
        <span class="signal-seg"><span class="signal-fill signal-fill-publish"></span></span>
        <span class="signal-seg"><span class="signal-fill signal-fill-keep"></span></span>
      </div>
      <ol class="cycle">
        {
          stages.map((stage) => (
            <li class={`cycle-${stage.id}`}>
              <p class="mono">
                <span class="stage-num">{stage.num}</span>
                {stage.label}
              </p>
              <p>{stage.body}</p>
            </li>
          ))
        }
      </ol>
      {
        pending(firstProof) ? (
          <aside class="hero-proof-preview" aria-labelledby="hero-proof-label">
            <p class="mono" id="hero-proof-label">
              Live sites
            </p>
            <div class="hero-proof-crops">
              {
                stories.map((story) => (
                  <a class="hero-proof-link frame" href={`/work#${story.id}`}>
                    <WorkCrop
                      id={story.id}
                      src={story.crop.src}
                      alt={story.crop.alt}
                    />
                    <span class="hero-proof-name">{story.client}</span>
                  </a>
                ))
              }
            </div>
          </aside>
        ) : (
          <aside class="proof-strip">
            <p class="mono">Proof</p>
            <p class="proof-quote">{firstProof}</p>
          </aside>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="mono section-label">Selected work</h2>
      <div class="proof">
        {
          stories.map((story) => (
            <a class="proof-panel frame" href={`/work#${story.id}`}>
              <WorkCrop
                id={story.id}
                src={story.crop.src}
                alt={story.crop.alt}
              />
              <div class="proof-copy">
                <p class="mono">{story.industry}</p>
                <h3>{story.client}</h3>
                <p class="figure figure-line">{story.title}</p>
                <p>{story.summary}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-ink">
    <div class="wrap">
      <h2>What a hire includes</h2>
      <div class="hire">
        {
          offers.map((offer) => (
            <article class="hire-row">
              <p class="mono">{offer.stage}</p>
              <h3>{offer.title}</h3>
              <p>{offer.short}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>How it starts</h2>
      <ol class="steps">
        {
          steps.map((step) => (
            <li>
              <span class="num">{step.num}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="wrap band-inner">
      <h2>Best fit</h2>
      <p>{bestFit}</p>
      <p class="price">{price}</p>
    </div>
  </section>

  <InquiryForm heading="Tell me about the business" intro="I read every note." />
</Base>
