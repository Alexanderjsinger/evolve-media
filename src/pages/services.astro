---
import Base from "../layouts/Base.astro";
import { faqs, offers, price, stories } from "../data/site";

const description =
  "Digital marketing, websites, technical setup, and practical AI for owners of small and mid-size businesses. Monthly marketing starts at $1,500.";
---

<Base
  title="Digital marketing for small businesses | Evolve Media"
  description={description}
>
  <header class="page-hero">
    <div class="wrap">
      <p class="mono">Services</p>
      <h1>Digital marketing for small and mid-size businesses</h1>
      <p>
        Marketing is the work. The website, the technical setup, and the AI are how
        that marketing holds.
      </p>
      <p class="price">{price}</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      {
        offers.map((offer) => (
          <article class="offer">
            <p class="mono">{offer.stage}</p>
            <div>
              <h2>{offer.title}</h2>
              <p>{offer.long}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="mono section-label">Proof</h2>
      <div class="proof">
        {
          stories.map((story) => (
            <a class="proof-panel" href={`/work#${story.id}`}>
              <p class="mono">{story.eyebrow}</p>
              <p class={story.figure ? "figure" : "figure figure-line"}>
                {story.figure || story.line}
              </p>
              <h3>{story.client}</h3>
              <p>{story.figure ? story.line : story.summary}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Questions owners ask</h2>
      {
        faqs.map((item) => (
          <div class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="band">
    <div class="wrap band-inner">
      <p class="price">{price}</p>
      <a class="button" href="/start">Tell me about the business</a>
    </div>
  </section>
</Base>
