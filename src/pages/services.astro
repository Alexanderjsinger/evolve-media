---
import Base from "../layouts/Base.astro";
import WorkCrop from "../components/WorkCrop.astro";
import { aiHelp, faqs, notAFit, offers, pageMeta, pending, price, stories } from "../data/site";
---

<Base title={pageMeta.services.title} description={pageMeta.services.description}>
  <header class="page-intro page-lead">
    <div class="wrap">
      <p class="mono">Services</p>
      <h1>Foundation, monthly marketing, and websites</h1>
      <p>
        Marketing is the work. The site and the tracking are how it holds. I read
        the data. I also stay a human you can talk to.
      </p>
      <p class="price">{price}</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      {
        offers.map((offer) => (
          <article class="offer">
            <p class="mono">{offer.stage}</p>
            <div>
              <h2>{offer.title}</h2>
              <p>{offer.long}</p>
              <p>
                <strong>Who it’s for.</strong> {offer.who}
              </p>
              <p class:list={[pending(offer.price) && "awaiting"]}>
                <strong>Fee.</strong> {offer.price}
              </p>
              <p class:list={[pending(offer.term) && "awaiting"]}>
                <strong>Term.</strong> {offer.term}
              </p>
              <h3>Deliverables</h3>
              <ul>
                {offer.deliverables.map((item) => (
                  <li class:list={[pending(item) && "awaiting"]}>{item}</li>
                ))}
              </ul>
              <div class="offer-extra">
                <h3>What you’ll see</h3>
                <p>{offer.whatYoullSee}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Not included</h2>
      <p class:list={[pending(notAFit) && "awaiting"]}>{notAFit}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{aiHelp.title}</h2>
      <ul class="plain-list">
        {aiHelp.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="mono section-label">Proof</h2>
      <div class="proof">
        {
          stories.map((story) => (
            <a class="proof-panel frame" href={`/work#${story.id}`}>
              <WorkCrop
                id={story.id}
                src={story.crop.src}
                alt={story.crop.alt}
              />
              <div class="proof-copy">
                <p class="mono">{story.industry}</p>
                <h3>{story.client}</h3>
                <p class="figure figure-line">{story.title}</p>
                <p>{story.summary}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Questions owners ask</h2>
      {
        faqs.map((item) => (
          <div class="faq-item">
            <h3>{item.q}</h3>
            <p class:list={[pending(item.a) && "awaiting"]}>{item.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="band">
    <div class="wrap band-inner">
      <p class="price">{price}</p>
      <a class="button" href="/start">Tell me about the business</a>
    </div>
  </section>
</Base>
