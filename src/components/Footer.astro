---
import Lockup from "./Lockup.astro";
import {
  email,
  fullName,
  linkedInIsLive,
  linkedInUrl,
  locationLine,
  name,
  nav,
} from "../data/site";
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <Lockup />
      <p class="muted">{locationLine}</p>
      <p class="fine">© {new Date().getFullYear()} {name}. {fullName}.</p>
    </div>
    <nav class="footer-nav" aria-label="Footer">
      <a href="/">Home</a>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/start">Start</a>
      {
        linkedInIsLive ? (
          <a href={linkedInUrl} target="_blank" rel="noopener noreferrer">
            LinkedIn
          </a>
        ) : (
          <span class="awaiting">{linkedInUrl}</span>
        )
      }
    </nav>
    <p>
      <a class="mail" href={`mailto:${email}`}>{email}</a>
    </p>
  </div>
</footer>
